{
  viAlias = true;
  vimAlias = true;

  #theming
  colorschemes.tokyonight = {
    enable = true;
    settings = {
      style = "night";
    };
  };

  opts = {
    number = true;
    relativenumber = true;

    tabstop = 2;
    shiftwidth = 2;
    softtabstop = 2;
    expandtab = true;
    smarttab = true;

    scrolloff = 8;
    colorcolumn = "80";
    hlsearch = false;
    termguicolors = false;
  };
}
